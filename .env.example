NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the anon JWT and/or the new publishable key (at least one must be set for browser + server session).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-or-leave-empty
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-sb-publishable-key-or-leave-empty
# Legacy name: SUPABASE_SERVICE_ROLE_KEY (service_role JWT). New dashboard label may use SUPABASE_SECRET_KEY (sb_secret_…).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SECRET_KEY=sb_secret_…
NEXT_PUBLIC_APP_ENV=development   # development | staging | production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# Optional override for the official HMRC Gift Aid donations schedule ODS.
# Defaults to templates/hmrc/R68GAD_V1_00_0_EN.ods
HMRC_GIFT_AID_ODS_TEMPLATE_PATH=

# Optional deployment metadata / Sentry release automation
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Demo mode (dev-only, read-only auth bypass)
DEMO_MODE=false                   # set to "true" to enable
DEMO_MODE_KEY=                    # secret key required in URL ?key=...
DEMO_ORG_ID=                      # UUID of the organisation to expose

# Platform support / internal admin allowlist
PLATFORM_ADMIN_EMAILS=            # comma-separated emails allowed to access /internal

# E2E smoke tests
BASE_URL=http://localhost:3000
E2E_EMAIL=
E2E_PASSWORD=

# Local SQL migration helpers: `npm run db:check-migrations`, `npm run db:verify-schema`
# or `npm run db:apply-signup-fields` (adds organisations.city/country if missing)
# Use the Database password from Supabase → Project Settings → Database (not the anon/service keys):
# SUPABASE_DB_PASSWORD=
# Or set a full Postgres URI:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres
